# 知行（Praxis）API 环境变量 —— 前缀统一 PRAXIS_

# Node 环境：development | test | production
PRAXIS_NODE_ENV=development

# 监听端口（设计 §7：本系统用 13000）
PRAXIS_PORT=13000

# 本 API 对外可访问的基础 URL（Better Auth 生成回调/链接用）
PRAXIS_PUBLIC_URL=http://127.0.0.1:13000

# PostgreSQL 连接串（设计 §7：库端口用 15432；凭据不入 git）
PRAXIS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/praxis

# Better Auth 会话签名密钥（生产必须强随机）
PRAXIS_AUTH_SECRET=

# 允许跨域的来源（Web 前端 dev，设计 §7：15173）
PRAXIS_CORS_ORIGIN=http://127.0.0.1:15173

# 运行日志级别
PRAXIS_LOG_LEVEL=debug

# 是否启用滚动文件日志（true 时 pino-roll 写入 logs/，按日期/大小滚动）
PRAXIS_LOG_FILE=false